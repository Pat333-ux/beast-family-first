import json
import os
import pytest
from jsonschema import validate, ValidationError

def test_program_300_schema_exists():
    assert os.path.exists("schemas/program_300_intake_schema.json"), "Program 300 intake schema missing!"

def test_valid_program_300_intake():
    schema_path = "schemas/program_300_intake_schema.json"
    with open(schema_path, "r", encoding="utf-8") as f:
        schema = json.load(f)

    valid_payload = {
        "assessment_id": "f81d4fae-7dec-11d0-a765-00a0c91e6bf6",
        "timestamp": "2026-10-22T14:45:00Z",
        "citizen_id": "nwo_citizen_0001",
        "program_type": "BEAST_FAMILY_FIRST",
        "eligibility_score": 90,
        "requested_token_grant": 1000,
        "judicial_approval_hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
        "sentinel_verification_sig": "a1b2c3d4e5f67890abcdef1234567890abcdef1234567890abcdef1234567890"
    }

    validate(instance=valid_payload, schema=schema)

def test_invalid_score_fails():
    schema_path = "schemas/program_300_intake_schema.json"
    with open(schema_path, "r", encoding="utf-8") as f:
        schema = json.load(f)

    invalid_payload = {
        "assessment_id": "f81d4fae-7dec-11d0-a765-00a0c91e6bf6",
        "timestamp": "2026-10-22T14:45:00Z",
        "citizen_id": "nwo_citizen_0001",
        "program_type": "BEAST_FAMILY_FIRST",
        "eligibility_score": 150,
        "requested_token_grant": 1000,
        "judicial_approval_hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
        "sentinel_verification_sig": "a1b2c3d4e5f67890abcdef1234567890abcdef1234567890abcdef1234567890"
    }

    with pytest.raises(ValidationError):
        validate(instance=invalid_payload, schema=schema)
